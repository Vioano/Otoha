{
  "name": "otoha",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "Human and multi-agent collaboration infrastructure",
  "bin": { "otoha": "bin/otoha.mjs" },
  "engines": { "node": ">=18" },
  "scripts": {
    "setup": "npm --prefix packages/graph ci --ignore-scripts",
    "test": "node scripts/test.mjs",
    "test:graph": "npm --prefix packages/graph test",
    "test:service": "node scripts/test.mjs collaboration",
    "test:mailbox": "python3 -m unittest discover -s integrations/mailbox/skills/otoha-mailbox/tests -v && python3 -m unittest discover -s integrations/mailbox/tests -v",
    "build:cli": "node scripts/build-cli.mjs",
    "check:names": "python3 scripts/check-names.py"
  },
  "repository": { "type": "git", "url": "https://github.com/Vioano/Otoha.git" }
}
