        ]
      }
    },
    {
      "id": "request.expected",
      "area": "request",
      "prompt": "用户本次明确要求的主要交付载体是什么？",
      "choices": [
        {
          "id": "working_ui",
          "label": "可操作的网站／应用界面"
        },
        {
          "id": "playable",
          "label": "可播放的动画／演示"
        },
        {
          "id": "still",
          "label": "静态视觉稿或方案研究"
        },
        {
          "id": "unknown",
          "label": "未查看／无法从实际成品确定",
          "unknown": true
        }
      ]
    },
    {
      "id": "request.actual",
      "area": "request",
      "prompt": "目前实际能打开或操作的交付物是什么？证据给出真实入口和观察结果。",
      "choices": [
        {
          "id": "working_ui",
          "label": "只有可操作界面，没有可播放作品"
        },
        {
          "id": "playable",
          "label": "只有可播放作品，没有可操作界面"
        },
        {
          "id": "both",
          "label": "同时有可操作界面与可播放作品"
        },
        {
          "id": "still",
          "label": "只有静态图"
        },
        {
          "id": "source",
          "label": "只有源码或描述"
        },
        {
          "id": "absent",
          "label": "没有可打开的成品"
        },
        {
          "id": "unknown",
          "label": "未查看／无法从实际成品确定",
          "unknown": true
        }
      ]
    },
    {
      "id": "interaction.selection_detail",
      "area": "interaction",
      "prompt": "若列表／图块把选择与“查看详情”分为独立入口，单击一条行正文（避开详情按钮）实际发生了什么？证据写出被点对象、选中态及详情区／弹窗前后状态。只有用户需求、项目约定或已确认设计明确采用选择即联动预览，才能作为该联动的例外依据；不能仅凭现存代码同时触发两种动作，就把它当作已获批准。合法 master-detail 或没有独立选择场景仍按实际任务说明依据。",
      "choices": [
        {
          "id": "select_only",
          "label": "只改变选择，未同时打开详情"
        },
        {
          "id": "opens_detail_too",
          "label": "存在独立详情入口，但单击行正文同时打开了详情"
        },
        {
          "id": "linked_or_no_separate_selection",
          "label": "用户需求／项目约定／已确认设计明确采用选择联动预览，或没有独立选择场景（证据说明依据）"
        },
        {
          "id": "unknown",
          "label": "未执行／无法从实际成品确定",
          "unknown": true
        }
      ],
      "required_when": {
        "interaction.controls": [
          "present"
        ]
      }
    },
    {
      "id": "interaction.keyboard_focus_target",
      "area": "interaction",
      "prompt": "在适用的 Web 同页主动作中，用键盘触发提交／确认等动作后，立即检查焦点实际落在哪里（先不要再按 Tab）。证据写出按键、动作，以及 document.activeElement 的标签名和可识别名称／区域；不适用时说明实际原因。",
      "choices": [
        {
          "id": "named_control_or_region",
          "label": "焦点落在具名控件或区域（证据写出具体对象）"
        },
        {
          "id": "body_or_html",
          "label": "焦点落在 BODY 或 HTML"
        },
        {
          "id": "not_applicable",
          "label": "非 Web、已进入新文档或没有适用的同页主动作（证据说明原因）"
        },
        {
          "id": "unknown",
          "label": "未执行／未读取实际焦点／无法判断",
          "unknown": true
        }
      ],
      "required_when": {
        "interaction.controls": [
          "present"
        ]
      }
    }
  ],
  "rules": [
    {
      "id": "layout.not-fully-viewed",
      "area": "layout",
      "when": {
        "layout.coverage": [
          "first_screen_only"
        ]
