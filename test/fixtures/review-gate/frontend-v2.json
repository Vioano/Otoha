        {
          "id": "not_opened",
          "label": "未打开成品查看"
        },
        {
          "id": "unknown",
          "label": "未查看／无法从实际成品确定",
          "unknown": true
        }
      ],
      "required_when": {
        "theme.requirement": [
          "both",
          "existing"
        ]
      }
    },
    {
      "id": "theme.initial",
      "area": "theme",
      "prompt": "清除本页手动主题偏好后首次打开，实际显示什么主题？",
      "choices": [
        {
          "id": "dark",
          "label": "深色"
        },
        {
          "id": "light",
          "label": "浅色"
        },
        {
          "id": "unknown",
          "label": "未查看／无法确定",
          "unknown": true
        }
      ],
      "required_when": {
        "theme.requirement": [
          "both"
        ]
      }
    },
    {
      "id": "theme.remembered",
      "area": "theme",
      "prompt": "手动切换主题后刷新，实际显示什么？",
      "choices": [
        {
          "id": "restored",
          "label": "仍显示刚才手动选择的主题"
        },
        {
          "id": "reset",
          "label": "重置为其他主题"
        },
        {
          "id": "unknown",
          "label": "未执行／无法确定",
          "unknown": true
        }
      ],
      "required_when": {
        "theme.requirement": [
          "both"
        ]
      }
    },
    {
      "id": "authorship.assigned",
      "area": "authorship",
      "prompt": "用户是否指定了负责可见文案的作者？",
      "choices": [
        {
          "id": "named",
          "label": "指定了作者"
        },
        {
          "id": "none",
          "label": "没有指定作者"
        },
        {
          "id": "unknown",
          "label": "未查看／无法从实际成品确定",
          "unknown": true
        }
      ]
    },
    {
      "id": "authorship.actual",
      "area": "authorship",
      "prompt": "正文、导航、按钮、状态及错误文案的实际来源是什么？",
      "choices": [
        {
          "id": "assigned",
          "label": "均来自指定作者，或由其确认"
        },
        {
          "id": "implementer",
          "label": "制作侧自行写入"
        },
        {
          "id": "mixed",
          "label": "存在未由指定作者确认的混合来源"
