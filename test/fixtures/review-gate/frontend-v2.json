{
  "version": 2,
  "title": "记录观察，由程序推导验收状态",
  "areas": [
    {
      "id": "layout",
      "name": "布局与辅助文案"
    },
    {
      "id": "interaction",
      "name": "真实交互与状态"
    },
    {
      "id": "prototype",
      "name": "界面打样与落实"
    },
    {
      "id": "reference",
      "name": "参考作品"
    },
    {
      "id": "theme",
      "name": "主题与可读性"
    },
    {
      "id": "authorship",
      "name": "文案分工"
    },
    {
      "id": "request",
      "name": "请求的实际交付载体"
    }
  ],
  "questions": [
    {
      "id": "layout.coverage",
      "area": "layout",
      "prompt": "实际查看了哪些页面模板、章节或本次改动的主要状态？证据中列出具体名称，不用“整体清楚”代替。",
      "choices": [
        {
          "id": "named_surfaces",
          "label": "已逐个查看并列出这些页面／状态"
        },
        {
          "id": "first_screen_only",
          "label": "只查看首屏或少量抽样"
        },
        {
          "id": "unknown",
          "label": "未查看／无法从实际成品确定",
          "unknown": true
        }
      ]
    },
    {
      "id": "layout.editorial",
      "area": "layout",
      "prompt": "逐个查看标题下、卡片下、图旁和页首的辅助文字，证据摘录原文与位置。是否出现介绍本页如何讲、逐步推进、沿哪里展开或如何操作本页的编排／界面自述？短语与口号同样检查，不能仅以“它是事实／教学内容”排除。具体概念、定义、必要限制另按对应对象判断。",
      "choices": [
        {
          "id": "present",
          "label": "看到了这类文字"
        },
        {
          "id": "absent",
          "label": "没有看到这类文字"
        },
        {
          "id": "unknown",
          "label": "未查看／无法从实际成品确定",
          "unknown": true
        }
      ]
    },
    {
      "id": "layout.guide_requested",
      "area": "layout",
      "prompt": "用户是否明确要求在成品中常驻展示操作教程或讲解编排说明？证据引用该要求；“要讲解知识”不等于要求介绍本页如何编排。",
      "choices": [
        {
          "id": "yes",
          "label": "用户明确要求了这类常驻说明"
        },
        {
          "id": "no",
          "label": "用户没有提出这类要求"
        },
        {
          "id": "unknown",
          "label": "未查看／无法从实际成品确定",
          "unknown": true
        }
      ]
    },
    {
      "id": "layout.duplicate",
      "area": "layout",
      "prompt": "是否看到了由旁边标题、按钮、分组、图形或状态已经表达的同一信息，又在辅助句中重复？包含各章节标题下的固定 intro。",
      "choices": [
        {
          "id": "present",
          "label": "看到了具体重复项"
        },
        {
          "id": "absent",
          "label": "没有看到重复项"
        },
        {
          "id": "unknown",
          "label": "未查看／无法从实际成品确定",
          "unknown": true
        }
      ]
    },
    {
      "id": "layout.necessary",
      "area": "layout",
      "prompt": "实际界面中的对象名、图中符号、控件标签、单位、错误原因或操作后果，出现了哪些？",
      "choices": [
        {
          "id": "present",
          "label": "适用的必要信息在相应对象或操作旁可见"
        },
        {
          "id": "no_such_elements",
          "label": "本次成品不存在需要这些标注的对象或操作"
        },
        {
          "id": "missing",
          "label": "存在相应对象或操作，但对应必要信息未显示"
        },
        {
          "id": "unknown",
          "label": "未查看／无法从实际成品确定",
          "unknown": true
        }
      ]
    },
    {
      "id": "layout.relation_carrier",
      "area": "layout",
      "prompt": "先列出本任务要求用户通过界面辨认、比较、追踪或操作的目标关系，再逐项记录“对象A可见名称—对象B可见名称—表达联系的实际分组／位置／连线／次序／前后状态”。相关卡片仅仅同屏不等于因果或方向已表达；none也要写明任务为何没有目标关系。正文、定义、必要限制、品牌叙事不按关系词或p标签一律判错；承担目标关系的句子也不能仅因叫“正文事实”豁免。",
      "choices": [
        {
          "id": "arranged_objects",
          "label": "这些关系都能在对应对象的分组、位置、连线、顺序或状态中定位"
        },
        {
          "id": "sentences_only",
          "label": "至少一项只在说明句中，界面没有对应的对象安排"
        },
        {
          "id": "none",
          "label": "本次界面没有这类需要表达的关系"
        },
        {
          "id": "unknown",
          "label": "未实际执行／无法确定",
          "unknown": true
        }
      ]
    },
    {
      "id": "layout.without_supporting_copy",
      "area": "layout",
      "prompt": "在检查用的实际页面中，临时隐藏复述界面安排的辅助文字并保留原占位，实际还看到了什么？不要按p标签批量隐藏；保留对象名、单位、控件、公式、定义、必要限定、操作后果、错误、原文／引文与正文／品牌叙事。证据摘录实际隐藏的文字，逐项列出仍可见的两端对象名称、位置／分组和方向／次序／状态编码；检查后恢复。无此类辅助文字时如实选无。若关系只剩空位或方向不明，重做布局，不能补解释。",
      "required_when": {
        "layout.relation_carrier": [
          "arranged_objects"
        ]
      },
      "choices": [
        {
          "id": "objects_located",
          "label": "实际隐藏后，仍逐项定位到了对应对象及关系"
        },
        {
          "id": "no_supporting_copy",
          "label": "实看没有这类可隐藏的辅助句；已逐项定位并列出对应对象与关系"
        },
        {
          "id": "missing_or_ambiguous",
          "label": "实际隐藏后，至少一项对象、次序、方向或状态无法定位"
        },
        {
          "id": "not_performed",
          "label": "未执行隐藏辅助文案后的实际查看",
          "unknown": true
        },
        {
          "id": "unknown",
          "label": "未实际执行／无法确定",
          "unknown": true
        }
      ]
    },
    {
      "id": "interaction.controls",
      "area": "interaction",
      "prompt": "本次成品是否包含可操作控件、导航、选择、展开或输入？",
      "choices": [
        {
          "id": "present",
          "label": "存在这些操作"
        },
        {
          "id": "none",
          "label": "仅静态内容，不含这些操作"
        },
        {
          "id": "unknown",
          "label": "未查看／无法从实际成品确定",
          "unknown": true
        }
      ]
    },
    {
      "id": "interaction.ran",
      "area": "interaction",
      "prompt": "实际执行过哪些操作？证据写出动作及操作前后状态。",
      "choices": [
        {
          "id": "executed",
          "label": "实际执行过本次涉及的操作"
        },
        {
          "id": "visual_only",
          "label": "只看了截图／源码，没有执行操作"
        },
        {
          "id": "unknown",
          "label": "未查看／无法从实际成品确定",
          "unknown": true
        }
      ],
      "required_when": {
        "interaction.controls": [
          "present"
        ]
      }
    },
    {
      "id": "interaction.observed",
      "area": "interaction",
      "prompt": "执行时看到了哪类现象？证据给出实际对象、数值或焦点位置，覆盖可见反馈和无障碍播报。",
      "choices": [
        {
          "id": "none_listed",
          "label": "未观察到下面列出的异常"
        },
        {
          "id": "no_response",
          "label": "操作后没有预期的状态变化"
        },
        {
          "id": "wrong_object",
          "label": "改变了错误对象或丢失原上下文"
        },
        {
          "id": "stale_feedback",
          "label": "可见状态／无障碍播报残留旧对象、数量或金额"
        },
        {
          "id": "keyboard_lost",
          "label": "键盘操作后焦点无故丢失，或控件不可达"
        },
        {
          "id": "unknown",
          "label": "未查看／无法从实际成品确定",
          "unknown": true
        }
      ],
      "required_when": {
        "interaction.controls": [
          "present"
        ],
        "interaction.ran": [
          "executed"
        ]
      }
    },
    {
      "id": "prototype.scope",
      "area": "prototype",
      "prompt": "本次用户要求及实际改动属于哪类？",
      "choices": [
        {
          "id": "new",
          "label": "新界面"
        },
        {
          "id": "major",
          "label": "重要视觉改版"
        },
        {
          "id": "minor",
          "label": "小型明确修改"
        },
        {
          "id": "approved",
          "label": "沿用用户已选定的界面方案"
        },
        {
          "id": "study",
          "label": "仅研究／展示视觉方案"
        },
        {
          "id": "unknown",
          "label": "未查看／无法从实际成品确定",
          "unknown": true
        }
      ]
    },
    {
      "id": "prototype.artifact",
      "area": "prototype",
      "prompt": "实际生成并查看的打样是什么？证据引用真实文件及其内容。",
      "choices": [
        {
          "id": "ui_mockup",
          "label": "能看到布局、层级与组件的界面稿"
        },
        {
          "id": "product_asset",
          "label": "只有照片／插图等产品素材"
        },
        {
          "id": "none",
          "label": "没有界面打样"
        },
        {
          "id": "unknown",
          "label": "未查看／无法从实际成品确定",
          "unknown": true
        }
      ],
      "required_when": {
        "prototype.scope": [
          "new",
          "major"
        ]
      }
    },
    {
      "id": "prototype.implemented",
      "area": "prototype",
      "prompt": "运行界面中，能否看到已采用方案的主要分组、层级和组件关系？",
      "choices": [
        {
          "id": "same_structure",
          "label": "能在运行界面定位这些对应结构"
        },
        {
          "id": "different_structure",
          "label": "运行界面没有这些对应结构"
        },
        {
          "id": "static_only",
          "label": "只有效果图，没有运行界面"
        },
        {
          "id": "unknown",
          "label": "未查看／无法从实际成品确定",
          "unknown": true
        }
      ],
      "required_when": {
        "prototype.scope": [
          "new",
          "major",
          "approved"
        ]
      }
    },
    {
      "id": "reference.observed",
      "area": "reference",
      "prompt": "本次实际查看过的设计参考来自哪里？证据给出页面／片段／本项目同类界面，以及采用的具体安排。",
      "choices": [
        {
          "id": "external",
          "label": "实际查看过同题材外部作品"
        },
        {
          "id": "project",
          "label": "实际查看过本项目已有或用户提供的选定界面"
        },
        {
          "id": "name_only",
          "label": "只提到品牌／作品名称，没有查看"
        },
        {
          "id": "none",
          "label": "没有查看任何对应作品"
        },
        {
          "id": "unknown",
          "label": "未查看／无法从实际成品确定",
          "unknown": true
        }
      ]
    },
    {
      "id": "theme.requirement",
      "area": "theme",
      "prompt": "用户或项目对主题的明确约定是什么？证据指出约定来源。",
      "choices": [
        {
          "id": "both",
          "label": "新界面／重要改版，且没有例外：深浅主题、默认深色并记忆"
        },
        {
          "id": "existing",
          "label": "已有明确主题约定，本次沿用"
        },
        {
          "id": "not_applicable",
          "label": "成品不是需要主题切换的界面，例如固定视觉稿"
        },
        {
          "id": "unknown",
          "label": "未查看／无法从实际成品确定",
          "unknown": true
        }
      ]
    },
    {
      "id": "theme.observed",
      "area": "theme",
      "prompt": "实际打开后看到了哪些主题与显示现象？证据包含视口和相关状态。",
      "choices": [
        {
          "id": "two_readable",
          "label": "实际查看深浅两种，文字与状态可读"
        },
        {
          "id": "one_readable",
          "label": "实际只看到一种主题，文字与状态可读"
        },
        {
          "id": "overflow_or_unreadable",
          "label": "看到遮挡、横向溢出或文字／状态不可读"
