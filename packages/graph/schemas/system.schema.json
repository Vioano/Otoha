{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archify System Design v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagram_type",
    "meta",
    "entities",
    "relations",
    "views",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "diagram_type": {
      "const": "system"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "locale",
        "rootView"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "locale": {
          "enum": [
            "en",
            "zh-CN"
          ]
        },
        "rootView": {
          "$ref": "#/$defs/id"
        },
        "demo": {
          "type": "boolean"
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "label",
          "purpose",
          "inputs",
          "outputs",
          "steps",
          "openIssues",
          "evidence",
          "maturity"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "parent": {
            "$ref": "#/$defs/id"
          },
          "type": {
            "enum": [
              "frontend",
              "backend",
              "database",
              "cloud",
              "security",
              "messagebus",
              "external"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "sublabel": {
            "type": "string",
            "maxLength": 100
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "maxItems": 100
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "maxItems": 100
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "maxItems": 100
          },
          "openIssues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "maxItems": 100
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "uniqueItems": true
          },
          "maturity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "design",
              "implementation",
              "verification",
              "integration"
            ],
            "properties": {
              "design": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "enum": [
                      "proposed",
                      "accepted",
                      "unknown"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/id"
                    },
                    "uniqueItems": true
                  }
                }
              },
              "implementation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "enum": [
                      "not_started",
                      "partial",
                      "implemented",
                      "unknown"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/id"
                    },
                    "uniqueItems": true
                  }
                }
              },
              "verification": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "enum": [
                      "untested",
                      "partial",
                      "passed",
                      "failed",
                      "unknown"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/id"
                    },
                    "uniqueItems": true
                  }
                }
              },
              "integration": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "enum": [
                      "not_connected",
                      "connected",
                      "running_verified",
                      "unknown"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/id"
                    },
                    "uniqueItems": true
                  }
                }
              }
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "kind",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "from": {
            "$ref": "#/$defs/id"
          },
          "to": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "dataflow",
              "dependency",
              "call",
              "feedback"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "maxItems": 5000
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "placements",
          "relations"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "scope": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "placements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entity",
                "pos"
              ],
              "properties": {
                "entity": {
                  "$ref": "#/$defs/id"
                },
                "pos": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "size": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "sublabel": {
                  "type": "string",
                  "maxLength": 100
                },
                "type": {
                  "enum": [
                    "frontend",
                    "backend",
                    "database",
                    "cloud",
                    "security",
                    "messagebus",
                    "external"
                  ]
                },
                "tag": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            },
            "minItems": 1,
            "maxItems": 100
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "relation"
              ],
              "properties": {
                "relation": {
                  "$ref": "#/$defs/id"
                },
                "fromSide": {
                  "enum": [
                    "left",
                    "right",
                    "top",
                    "bottom"
                  ]
                },
                "toSide": {
                  "enum": [
                    "left",
                    "right",
                    "top",
                    "bottom"
                  ]
                },
                "via": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "labelAt": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "labelDx": {
                  "type": "number"
                },
                "labelDy": {
                  "type": "number"
                },
                "variant": {
                  "enum": [
                    "default",
                    "emphasis",
                    "dashed"
                  ]
                }
              }
            },
            "maxItems": 300
          },
          "viewBox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "kind": {
            "enum": [
              "structure",
              "perspective",
              "scenario"
            ]
          },
          "entryPoints": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "uniqueItems": true,
            "maxItems": 100
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dot",
                "title",
                "items"
              ],
              "properties": {
                "dot": {
                  "enum": [
                    "cyan",
                    "emerald",
                    "violet",
                    "amber",
                    "rose",
                    "orange",
                    "slate"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "guidedViews": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "focus"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 48
                },
                "focus": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "note": {
                  "type": "string",
                  "maxLength": 140
                }
              }
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 100
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "path",
          "sha256"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "design",
              "source",
              "test",
              "runtime"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "result": {
            "enum": [
              "passed",
              "failed"
            ]
          },
          "capturedAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "inputs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/binding"
            },
            "minItems": 1,
            "maxItems": 100
          }
        }
      },
      "maxItems": 5000
    },
    "tasks": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
      "maxLength": 100
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "assignees",
        "entities",
        "description",
        "acceptance",
        "deliverables",
        "blocked"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "enum": [
            "todo",
            "doing",
            "review",
            "done"
          ]
        },
        "assignees": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "entities": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "description": {
          "type": "string",
          "maxLength": 8000
        },
        "acceptance": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "deliverables": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "blocked": {
          "type": "string",
          "maxLength": 2000
        }
      }
    }
  }
}
